# Copy to .env and adjust. All values are optional.
HTTP_PORT=80
HTTPS_PORT=443
FTP_PORT=21
# allow explicit FTPS (AUTH TLS) on FTP_PORT
FTP_TLS=true
# TLS engine: auto (OpenSSL; kernel TLS if the host ran `sudo modprobe tls`) | zerocopy | off (.NET SslStream)
KTLS=auto
# CPUs for memserve, e.g. "0-15" = the P-cores of an i7-13700K (see `lscpu -e`); empty = all
MEMSERVE_CPUSET=
# PEM certificate/key paths inside the container (mount them, see compose.yaml); empty = self-signed
TLS_CERT=
TLS_KEY=
FTP_PASV_PORTS=50000-50100
# IP advertised in FTP PASV replies; only needed behind NAT / bridge networking
FTP_PASV_ADDR=
# RAM holding memserve's random pattern (files of any size cycle through it)
MEMSERVE_BACKING=1G
STATS_INTERVAL=1

SMB_PORT=445
SMB_SHARE=bench
SMB_USER=bench
SMB_PASS=bench
SMB_GUEST=yes
# real files created on the tmpfs at start; they use this much RAM
SMB_FILES=1G,10G
# tmpfs cap: must cover SMB_FILES plus uploads (RAM is only used as data is written; uploads stay in RAM until deleted)
SMB_TMPFS_SIZE=16g
# SMB3 encryption: default (client decides) | off | desired | required (required disables guest access)
SMB_ENCRYPT=default
# restrict the interfaces Samba advertises for multichannel, e.g. "eth0 eth1"
SMB_INTERFACES=
